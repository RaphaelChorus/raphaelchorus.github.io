<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>라파엘코러스 로고 추출기</title>
    <link href="https://fonts.googleapis.com/css2?family=Princess+Sofia&display=swap" rel="stylesheet">
    <style>
        body { text-align: center; padding: 50px; background: #f0f0f0; font-family: sans-serif; }
        #canvas-container { 
            background: url('https://www.transparenttextures.com/patterns/checkerboard.png'); /* 투명 배경 확인용 */
            display: inline-block; 
            padding: 20px; 
            border: 2px dashed #ccc;
            cursor: pointer;
        }
        .instructions { margin-top: 20px; color: #666; }
        canvas { display: none; } /* 실제 파일 생성을 위한 캔버스 */
        #display-text {
            font-family: 'Princess Sofia', cursive;
            font-size: 100px;
            color: #ffcc00; /* 원하는 색상으로 변경 가능 */
            user-select: none;
        }
    </style>
</head>
<body>

    <h2>Raphael Chorus 로고 생성기</h2>
    <p class="instructions">아래 글자를 클릭하면 <b>배경이 투명한 PNG 이미지</b>가 다운로드됩니다.</p>

    <div id="canvas-container" onclick="downloadLogo()">
        <div id="display-text">Raphael Chorus</div>
    </div>

    <canvas id="logoCanvas" width="1200" height="300"></canvas>

    <script>
        function downloadLogo() {
            const canvas = document.getElementById('logoCanvas');
            const ctx = canvas.getContext('2d');
            
            // 캔버스 초기화 (투명)
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // 폰트 설정
            ctx.font = "120px 'Princess Sofia'";
            ctx.fillStyle = "#ffcc00"; // 금색
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            
            // 텍스트 그리기
            ctx.fillText("Raphael Chorus", canvas.width / 2, canvas.height / 2);
            
            // 이미지로 저장
            const link = document.createElement('a');
            link.download = 'Raphael_Chorus_Logo.png';
            link.href = canvas.toDataURL("image/png");
            link.click();
        }

        // 폰트 로딩 대기
        window.onload = function() {
            document.fonts.ready.then(function() {
                console.log('Font loaded');
            });
        };
    </script>
</body>
</html>
